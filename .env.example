# ============================================
# Grid Manual Bot — Environment Variables
# Copy this file to .env and fill in your values
# ============================================

# --- Crypto.com API credentials ---
CRO_API_KEY=your_api_key_here
CRO_SECRET_KEY=your_secret_key_here

# --- Network mode ---
# PUBLIC = direct connection (default)
# CDC    = local proxy (advanced)
CRO_NETWORK=PUBLIC

# --- Multi-user server settings ---
# SOURCE_IP: EC2 private IP for outbound traffic binding (leave empty for local)
SOURCE_IP=
# DASHBOARD_PORT: per-user Flask dashboard port
DASHBOARD_PORT=5560
# USER_ID: unique identifier for this user
USER_ID=default

# --- Trading ---
# ORDER_QTY: BTC quantity per grid lot
ORDER_QTY=0.0001

# --- Admin panel encryption ---
# MASTER_KEY: Fernet key for encrypting user configs (auto-generated if empty)
MASTER_KEY=
